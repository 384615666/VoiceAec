diff --git a/ggml/tests/daf_reference_math.cpp b/ggml/tests/daf_reference_math.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..44f2e8e3a469371d9958b567d4b876f39dd48fe7
--- /dev/null
+++ b/ggml/tests/daf_reference_math.cpp
@@ -0,0 +1,20 @@
+// Deliberately perturb libm rounding: evaluate elementary functions in double
+// and round back to float. This is a stability oracle, not a PyTorch reference.
+// Compile the production filter a second time under distinct public symbols.
+#include <cmath>
+static float daf_test_log(float x) { return (float)std::log10((double)x); }
+static float daf_test_sqrt(float x) { return (float)std::sqrt((double)x); }
+static float daf_test_exp(float x) { return (float)std::exp((double)x); }
+static float daf_test_tanh(float x) { return (float)std::tanh((double)x); }
+
+#define daf_init daf_reference_init
+#define daf_init_npy daf_reference_init_npy
+#define daf_init_tensors daf_reference_init_tensors
+#define daf_reset daf_reference_reset
+#define daf_process daf_reference_process
+#define daf_prime_delay daf_reference_prime_delay
+#define log10f daf_test_log
+#define sqrtf daf_test_sqrt
+#define expf daf_test_exp
+#define tanhf daf_test_tanh
+#include "../daf_frontend.cpp"
