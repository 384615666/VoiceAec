diff --git a/ggml/daf_math.h b/ggml/daf_math.h
new file mode 100644
index 0000000000000000000000000000000000000000..7ac7e08041c0a29b1515de57e28382739684b924
--- /dev/null
+++ b/ggml/daf_math.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <algorithm>
+
+struct daf_limited_gain {
+    float mu;
+    float covariance_factor;
+};
+
+// The same capped product must drive both the gain and covariance update.
+// Rescaling mu and multiplying it back by x2 can round just below 2, leaving
+// a spurious covariance (~6e-5 at P=1000 instead of the 1e-12 floor). That
+// residue changes later adaptive updates by orders of magnitude across libms.
+inline daf_limited_gain daf_limit_gain(float mu, float x2) {
+    const float product = mu * x2;
+    if (product >= 2.0f) return {2.0f / x2, 0.0f};
+    return {mu, std::max(1.0f - 0.5f * product, 0.0f)};
+}
