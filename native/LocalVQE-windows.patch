diff --git a/ggml/tests/test_daf_numerics.cpp b/ggml/tests/test_daf_numerics.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..360f6e9b3b45fd50edd8b268c6fcc185350b0a9a
--- /dev/null
+++ b/ggml/tests/test_daf_numerics.cpp
@@ -0,0 +1,81 @@
+#include "daf_frontend.h"
+#include "daf_math.h"
+#include "test_helpers.h"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+bool daf_reference_init(daf_frontend&, const dvqe_graph_model&);
+void daf_reference_process(daf_frontend&, const float*, const float*, int, float*, float*);
+void daf_reference_prime_delay(daf_frontend&, const float*, const float*, int);
+
+static bool test_gain() {
+    int old_residuals = 0;
+    for (int i = 1; i <= 10000; ++i) {
+        const float x2 = i * 0.137f;
+        for (float scale : {0.0f, 0.25f, 0.75f, 1.25f, 3.125f}) {
+            const float mu = scale * 2.0f / x2;
+            const auto actual = daf_limit_gain(mu, x2);
+            const long double product = (long double)mu * x2;
+            const long double expected_mu = product >= 2 ? 2.0L / x2 : mu;
+            const long double expected_factor = std::max(1.0L - 0.5L * product, 0.0L);
+            if (std::fabs(actual.mu - expected_mu) > 2e-7L * std::max(1.0L, expected_mu) ||
+                std::fabs(actual.covariance_factor - expected_factor) > 2e-7L ||
+                (product > 2 && actual.covariance_factor != 0.0f)) return false;
+            float old_mu = mu;
+            const float s = mu * x2;
+            if (s > 2) old_mu *= 2.0f / s;
+            if (s > 2 && 1.0f - 0.5f * old_mu * x2 > 0) ++old_residuals;
+        }
+    }
+    std::printf("PASS: 50000 gain/covariance cases against long-double algebra; "
+                "old formula left %d saturated residuals\n", old_residuals);
+    return old_residuals > 0;
+}
+
+int main(int argc, char** argv) {
+    if (!test_gain()) { std::puts("FAIL: gain/covariance invariant"); return 1; }
+    if (argc == 2 && std::strcmp(argv[1], "--gain-only") == 0) return 0;
+    const bool prime = argc == 3 && std::strcmp(argv[2], "--prime") == 0;
+    if (argc != 2 && !prime) return 1;
+    const auto model_path = localvqe_test::resolve_gguf("", "localvqe-v1.4-aec-200K-f32.gguf");
+    if (model_path.empty()) { std::puts("SKIP: v1.4 model missing"); return 77; }
+    dvqe_graph_model model;
+    if (!load_graph_model(model_path.c_str(), model, false)) return 1;
+    daf_frontend normal, reference;
+    if (!daf_init(normal, model) || !daf_reference_init(reference, model)) return 1;
+    FILE* f = std::fopen(argv[1], "rb");
+    if (!f) return 1;
+    std::fseek(f, 0, SEEK_END);
+    const long bytes = std::ftell(f);
+    std::rewind(f);
+    if (bytes <= 0 || bytes % (2 * sizeof(float) * daf_frontend::M) != 0) {
+        std::fclose(f);
+        return 1;
+    }
+    const size_t samples = bytes / (2 * sizeof(float));
+    std::vector<float> input(2 * samples), a(samples), b(samples);
+    const auto count = std::fread(input.data(), sizeof(float), input.size(), f);
+    std::fclose(f);
+    if (count != input.size()) return 1;
+    if (prime) {
+        daf_prime_delay(normal, input.data(), input.data() + samples, (int)samples);
+        daf_reference_prime_delay(reference, input.data(), input.data() + samples, (int)samples);
+    }
+    daf_process(normal, input.data(), input.data() + samples, (int)samples, a.data(), nullptr);
+    daf_reference_process(reference, input.data(), input.data() + samples, (int)samples, b.data(), nullptr);
+    float max_diff = 0;
+    int violations = 0;
+    for (size_t i = 0; i < a.size(); ++i) {
+        const float d = std::fabs(a[i] - b[i]);
+        max_diff = std::max(max_diff, d);
+        if (!std::isfinite(a[i]) || !std::isfinite(b[i]) ||
+            d > 1e-3f + 1e-2f * std::fabs(b[i])) ++violations;
+    }
+    free_graph_model(model);
+    std::printf("%s: float libm vs double libm: max diff %.9g, violations %d / %zu, shift %d / %d\n",
+                violations ? "FAIL" : "PASS", max_diff, violations, samples,
+                normal.cur_shift, reference.cur_shift);
+    return violations ? 1 : 0;
+}
